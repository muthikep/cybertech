EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Absolute URL the app's API is reachable at (never localhost/127.0.0.1 -
# a packaged app can't reach your machine by that name). For local dev with
# a device/emulator, use your computer's LAN IP and Metro's port, e.g.
# http://192.168.1.23:8081. For builds, use the deployed server's URL.
EXPO_PUBLIC_API_BASE_URL=
CLERK_SECRET_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ANTHROPIC_API_KEY=
