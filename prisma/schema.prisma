generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String        @id @default(cuid())
  clerkId   String        @unique
  createdAt DateTime      @default(now())
  sessions  ChatSession[]
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  startedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
